# Frontend
VITE_API_BASE_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# Backend
NODE_ENV=development
PORT=3001
# Note: If your password contains special characters (e.g. @), URL-encode them (@ becomes %40)
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/bulk_sms
REDIS_URL=redis://127.0.0.1:6379

# SMS Gateway - Choose one provider and fill in its credentials
# ---- Twilio ----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ---- Africa's Talking ----
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username

# ---- Vonage ----
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM_NUMBER=YourBrand

# ---- Briq (Tanzania) - https://briq.tz ----
# Get your keys from: https://dashboard.briq.tz
BRIQ_API_KEY=your_briq_api_key
BRIQ_APP_ID=your_briq_app_key
BRIQ_SENDER_ID=BRIQ

# Active SMS Provider (twilio | africas_talking | vonage | briq)
SMS_PROVIDER=briq

# Optional: Fallback provider if primary fails (twilio | africas_talking | vonage | briq)
# FALLBACK_SMS_PROVIDER=twilio

# Queue
QUEUE_CONCURRENCY=10
QUEUE_RATE_LIMIT=100

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d

# Webhook - Get this from your SMS provider's dashboard when creating a webhook
# Briq: Create a webhook at https://dashboard.briq.tz pointing to:
#   https://<your-domain>/api/webhooks/delivery-report
WEBHOOK_SECRET=your_webhook_signing_secret
